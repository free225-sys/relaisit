# Copiez ce fichier en `.env` et renseignez les valeurs réelles.
# Ne versionnez jamais le fichier `.env`.

# Connexion MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=relaisit

# Domaines autorisés à appeler l'API, séparés par des virgules.
# N'utilisez JAMAIS `*` en production.
CORS_ORIGINS=https://relaisit.com,https://www.relaisit.com

# Espace d'administration (/admin)
# Générez un mot de passe long et aléatoire, par exemple :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_PASSWORD=

# Clé de signature des jetons de session admin.
# Générez-la de la même façon, et ne la réutilisez nulle part ailleurs.
JWT_SECRET=
